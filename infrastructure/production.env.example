# Copy to .env.production beside compose.production.yaml. Never commit the copy.

# The app is served at this domain, the API at api.<domain> and video at
# media.<domain>. Point all three at the machine before starting Caddy, which
# fetches their certificates on first start.
SCRY_DOMAIN=

SCRY_POSTGRES_PASSWORD=

# Observers allowed to report and to sign results, as id=address pairs. The same
# addresses must be registered in ObserverRegistry on every chain in SCRY_CHAINS,
# or their signatures are refused on chain. Observers need no gas.
SCRY_OBSERVERS=vision-01=0x0000000000000000000000000000000000000000,verify-01=0x0000000000000000000000000000000000000000
SCRY_PRIMARY_OBSERVER_KEY=
SCRY_VERIFY_OBSERVER_KEY=

# How many cameras run markets at the same time. One observer pair watches one
# camera, so this is also how many pairs must be running: a market on a camera
# with no pair free can only void. Each extra pair needs its own two keys, its
# own ids in SCRY_OBSERVERS, and those addresses registered on every chain.
SCRY_OBSERVER_PAIRS=1

# Lets operator scripts submit streams without a wallet session.
SCRY_OPERATOR_TOKEN=

# Chains markets take positions on. Testnets first: 84532 is Base Sepolia, 80002
# is Polygon Amoy. Mainnet is 8453 (Base) and 137 (Polygon).
SCRY_CHAINS=84532,80002

# The operator creates markets and proposes, finalizes and voids results. It
# never holds anyone's stake, but it pays gas on every chain above, so keep a
# small balance of ETH on Base and POL on Polygon, and alert on it running low.
SCRY_OPERATOR_KEY=

# scripts/deploy-contracts.sh prints the factory and resolver lines for a chain.
SCRY_RPC_84532=https://sepolia.base.org
SCRY_FACTORY_84532=
SCRY_RESOLVER_84532=

SCRY_RPC_80002=https://rpc-amoy.polygon.technology
SCRY_FACTORY_80002=
SCRY_RESOLVER_80002=

# Use a provider key on mainnet. Public endpoints rate-limit the log queries the
# indexer makes every few seconds.
SCRY_RPC_8453=
SCRY_FACTORY_8453=
SCRY_RESOLVER_8453=

SCRY_RPC_137=
SCRY_FACTORY_137=
SCRY_RESOLVER_137=
