# Hosts the HLS proxy at /api/stream is allowed to fetch from.
# Comma separated. Subdomains of a listed host are allowed.
# Leave empty to disable proxying entirely — the proxy returns 503 when unset.
# Only add hosts whose operator permits embedding; most state DOT camera
# networks do, with attribution. Check the source agency, not the aggregator.
SCRY_STREAM_ALLOWED_HOSTS=

# Landing hero video. Falls back to /landing/hero.mp4 when unset.
NEXT_PUBLIC_SCRY_HERO_VIDEO=

# Point the frontend at the Go API instead of the built-in simulator.
# Both must be set together, otherwise MockScryApi is used.
NEXT_PUBLIC_SCRY_API_URL=
NEXT_PUBLIC_SCRY_WS_URL=

# Optional media sources, used when a market has no explicit streamUrl.
NEXT_PUBLIC_SCRY_STREAM_URL_TEMPLATE=
NEXT_PUBLIC_SCRY_HLS_BASE_URL=
NEXT_PUBLIC_SCRY_LIVEKIT_URL=

# Route the client through /api/stream for hosts that send no CORS headers.
NEXT_PUBLIC_SCRY_STREAM_PROXY_HOSTS=

# Prefer public cameras over the bundled clips. Cameras are dark half the day
# and drop without notice, so this is off by default.
SCRY_PREFER_LIVE_CAMERAS=

# mediamtx republishing origin, e.g. http://127.0.0.1:8888
SCRY_MEDIA_ORIGIN=

# --- Go API ---
# Unset falls back to the in-memory store.
SCRY_DATABASE_URL=postgres://scry:CHANGEME@127.0.0.1:5432/scry
SCRY_HTTP_ADDR=:8080
SCRY_ALLOWED_ORIGIN=http://localhost:3000

# Required by compose. Pick your own.
SCRY_POSTGRES_PASSWORD=
